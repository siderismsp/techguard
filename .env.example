# TechGuard Configuration
# Copy this to .env and fill in your values

# Technitium DNS Server connection
# Change this to your Technitium server's IP
TECHNITIUM_URL=http://192.168.188.55:5380

# API key from Technitium DNS Server (Settings → API → API Key)
# Leave empty if not using authentication
TECHNITIUM_API_KEY=

# Port for the backend API
PORT=3001